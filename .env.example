# Asty ERP — Frontend Environment Variables
# Copy this file to .env.local and fill in your Supabase Mumbai (ap-south-1) project credentials.
# Leave blank to run in interactive Local/IndexedDB Demo Mode with pre-seeded Kerala site data.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the frontend!

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WEB_PUSH_PUBLIC_VAPID_KEY=

